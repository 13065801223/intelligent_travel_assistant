LLM_API_KEY=ms-xxxxxxxx
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL_ID=Qwen/Qwen3.8-Flash-Next
# 单次 LLM 调用超时；须小于 AGENT_DEADLINE_SECONDS
LLM_TIMEOUT=300
# 推理档位：low 明显更快；留空则用端点默认
LLM_REASONING_EFFORT=low
# 429/5xx 的有界重试与等待总预算
LLM_RETRIES=3
LLM_RETRY_BUDGET_SECONDS=20

AMAP_API_KEY=你的高德Web服务Key
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO
AGENT_MODE=stub        # stub=直接回黄金样本（开发期）；real=真 LLM+MCP
AGENT_DEADLINE_SECONDS=570
AGENT_MAX_TOOL_ITERATIONS=3

# PyPI 镜像：国内网络必配，否则 uvx 首次拉取 MCP 服务器会超时
MCP_UV_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# uv 缓存目录：留空则落在仓库内（受限环境下必须可写）
# MCP_UV_CACHE_DIR=
# MCP_UV_TOOL_DIR=

MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8199
MCP_START_TIMEOUT=120

# 服务器命令（一般不用改；用 uvx 就保持这两行）
MCP_COMMAND=uvx
MCP_ARGS=amap-mcp-server